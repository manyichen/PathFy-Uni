# Offline job capability evaluation. Copy to tools/job_eval/.env.
# Credentials may match backend/.env, but this file is loaded independently.

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
PRIMARY_PROVIDER=deepseek
REVIEW_PROVIDER=qwen
REVIEW_CONFIDENCE_THRESHOLD=0.60
LLM_TIMEOUT_SECONDS=180

CAP_VERSION=v1.0.0-pilot200
JOB_EVAL_WORKERS=3
JOB_EVAL_LIMIT=200
JOB_EVAL_START=1
