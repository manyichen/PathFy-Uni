# PathFy-Uni backend environment
# Copy to backend/.env. Never commit backend/.env or real credentials.
# Values below match backend/app/core/config.py defaults unless marked REQUIRED.

# --- Flask and authentication ---
FLASK_ENV=development
FLASK_DEBUG=1
# REQUIRED outside local development: generate a long random value.
SECRET_KEY=replace-with-a-long-random-secret
TOKEN_EXPIRES_HOURS=24
FRONTEND_ORIGIN=http://localhost:4321

# --- MySQL (runtime and Alembic) ---
# The database must exist; `alembic upgrade head` creates its tables.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=suilli_mizi

# --- Neo4j job graph ---
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Resume upload and OCR ---
MAX_UPLOAD_MB=10
# Leave unset to use backend/private_uploads/resumes.
# RESUME_UPLOAD_DIR=/var/lib/pathfy/private_uploads/resumes
DELETE_UPLOADED_RESUME_AFTER_OCR=true
OCR_APP_ID=
OCR_API_KEY=
OCR_SECRET_KEY=
OCR_CONNECT_TIMEOUT_SECONDS=3
OCR_SOCKET_TIMEOUT_SECONDS=20
OCR_MAX_PDF_PAGES=12

# --- LLM credentials ---
# Ark/Doubao: jobs assistant, report copywriting and graph extraction fallback.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-mini-260215
# DashScope: personality analysis and legacy resume scoring utilities.
DASHSCOPE_API_KEY=
# DeepSeek: match refinement, report planning/review and public-info summaries.
DEEPSEEK_API_KEY=
# Optional Google search provider for public career information.
SERPER_API_KEY=

# Business defaults are inserted into MySQL as system-settings revision 1 by
# `alembic upgrade head`. Manage jobs, matching, reports, graph task parameters,
# model choices and platform AI switches in the administrator console.
# Legacy business environment variables remain readable for one compatibility
# release, but are intentionally omitted from this template.

# --- Privacy and local retention ---
LLM_PRIVACY_MODE=true
LLM_MAX_TEXT_CHARS=4000
LLM_MAX_RESUME_CHARS=20000
LLM_MAX_FIELD_CHARS=1200
LLM_STORE_RAW_SNIPPETS=false
LOCAL_STORE_RAW_RESUME_TEXT=false
LOCAL_STORE_RAW_REVIEW_TEXT=false
LOCAL_STORE_RAW_CHAT_MESSAGES=false
LOCAL_MAX_STORED_TEXT_CHARS=4000
API_CACHE_NO_STORE=true

# --- Person-job matching hard limit ---
MATCH_PREVIEW_MAX_SCAN_HARD=8000

# --- Incremental graph ETL (backend/app/domains/graph) ---
# Base URLs, API keys, paths, release version and worker polling remain deployment settings.
# Models, batching, retries, timeouts and thresholds are stored in the system-settings revision.
# GRAPH_LLM credentials fall back to the corresponding ARK values when left empty.
GRAPH_LLM_BASE_URL=
GRAPH_LLM_API_KEY=
# Leave empty to use the service's default backup location.
GRAPH_PROMOTION_BACKUP_DIR=
# Queue uploads are private and retained for authenticated history downloads.
# GRAPH_TASK_UPLOAD_DIR=/var/lib/pathfy/private_uploads/graph_tasks
GRAPH_CAP_VERSION=job-cap-v2
GRAPH_CAP_PRIMARY_BASE_URL=https://api.deepseek.com
GRAPH_CAP_REVIEW_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GRAPH_WORKER_POLL_SECONDS=2
GRAPH_WORKER_LEASE_SECONDS=60
GRAPH_WORKER_MAX_ATTEMPTS=3
GRAPH_WORKER_RETRY_BASE_SECONDS=5
