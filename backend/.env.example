# PathFy-Uni backend environment
# Copy to backend/.env. Never commit backend/.env or real credentials.
# Values below match backend/app/core/config.py defaults unless marked REQUIRED.

# --- Flask and authentication ---
FLASK_ENV=development
FLASK_DEBUG=1
# REQUIRED outside local development: generate a long random value.
SECRET_KEY=replace-with-a-long-random-secret
TOKEN_EXPIRES_HOURS=24
FRONTEND_ORIGIN=http://localhost:4321

# --- MySQL (runtime and Alembic) ---
# The database must exist; `alembic upgrade head` creates its tables.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=suilli_mizi

# --- Neo4j job graph ---
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Resume upload and OCR ---
MAX_UPLOAD_MB=10
# Leave unset to use backend/private_uploads/resumes.
# RESUME_UPLOAD_DIR=/var/lib/pathfy/private_uploads/resumes
DELETE_UPLOADED_RESUME_AFTER_OCR=true
OCR_APP_ID=
OCR_API_KEY=
OCR_SECRET_KEY=
OCR_CONNECT_TIMEOUT_SECONDS=3
OCR_SOCKET_TIMEOUT_SECONDS=20
OCR_MAX_PDF_PAGES=12

# --- LLM credentials ---
# Ark/Doubao: jobs assistant, report copywriting and graph extraction fallback.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-mini-260215
# DashScope: personality analysis and legacy resume scoring utilities.
DASHSCOPE_API_KEY=
# DeepSeek: match refinement, report planning/review and public-info summaries.
DEEPSEEK_API_KEY=
# Optional Google search provider for public career information.
SERPER_API_KEY=

# --- Jobs AI assistant ---
AI_MAX_RETURN_JOBS=40
AI_CONTEXT_WINDOW=6
AI_LLM_TIMEOUT_SECONDS=90

# --- Privacy and local retention ---
LLM_PRIVACY_MODE=true
LLM_MAX_TEXT_CHARS=4000
LLM_MAX_RESUME_CHARS=20000
LLM_MAX_FIELD_CHARS=1200
LLM_STORE_RAW_SNIPPETS=false
LOCAL_STORE_RAW_RESUME_TEXT=false
LOCAL_STORE_RAW_REVIEW_TEXT=false
LOCAL_STORE_RAW_CHAT_MESSAGES=false
LOCAL_MAX_STORED_TEXT_CHARS=4000
API_CACHE_NO_STORE=true

# --- Person-job matching ---
MATCH_PREVIEW_MAX_SCAN=2000
MATCH_PREVIEW_MAX_SCAN_HARD=8000
MATCH_TOP_K_RETURN=30
MATCH_LLM_POOL_K=40
MATCH_COARSE_SHAPE_WEIGHT=0.42
MATCH_GAP_SOFT_MARGIN_FIT=6
MATCH_GAP_SOFT_MARGIN_STRETCH=10
MATCH_STRETCH_MATCH_SCORE_FLOOR=38
MATCH_STRETCH_SORT_W_MATCH=0.32
MATCH_STRETCH_SORT_W_JOB_AVG=0.68
MATCH_DEEPSEEK_MODEL=deepseek-chat
MATCH_LLM_TIMEOUT_SECONDS=120

# --- Career reports ---
CAREER_DEEPSEEK_MODEL=deepseek-chat
CAREER_ARK_MODEL=doubao-seed-2-0-lite-260215
CAREER_LLM_TIMEOUT_SECONDS=120
CAREER_LLM_MAX_RETRIES=2
CAREER_REVIEW_EXTRACT_TEMPERATURE=0.55
CAREER_ENABLE_COPYWRITER=true
CAREER_ENABLE_PER_TARGET_COPYWRITER=true
CAREER_ENABLE_REPLAN_LLM=true
CAREER_ENABLE_TREND_AUGMENT=false
CAREER_ENABLE_PUBLIC_INFO=true
CAREER_PUBLIC_INFO_CACHE_DAYS=14
CAREER_PUBLIC_INFO_MAX_SUMMARY_CHARS=300
CAREER_PUBLIC_SEARCH_MAX_CHARS=1200
CAREER_ENABLE_GRAPH_RECOMMENDATIONS=true
CAREER_ENABLE_RECOMMENDATION_LLM=true
CAREER_ENABLE_PLAN_CUSTOMIZATION=true
CAREER_LR_POOL_PER_TARGET=18
CAREER_COMP_POOL_PER_TARGET=10
CAREER_LR_PER_TARGET=6
CAREER_COMP_PER_TARGET=3

# --- Incremental graph ETL (backend/app/domains/graph) ---
# GRAPH_LLM_* fall back to the corresponding ARK_* values when left empty.
GRAPH_LLM_BASE_URL=
GRAPH_LLM_API_KEY=
GRAPH_LLM_MODEL=doubao-seed-2-0-mini-260215
GRAPH_BATCH_SIZE=128
GRAPH_MAX_RETRIES=5
GRAPH_LLM_TIMEOUT_SECONDS=120
GRAPH_PROMOTION_MIN_CONFIDENCE=0.55
# Leave empty to use the service's default backup location.
GRAPH_PROMOTION_BACKUP_DIR=
# Queue uploads are private and removed after confirm/reject/cancel.
# GRAPH_TASK_UPLOAD_DIR=/var/lib/pathfy/private_uploads/graph_tasks
GRAPH_WORKER_POLL_SECONDS=2
