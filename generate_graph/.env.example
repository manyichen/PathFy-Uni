# Standalone graph-generation tools. Copy to generate_graph/.env.

# Neo4j target
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Main Excel-to-graph pipeline (`script.py`)
# Input is selected with `--excel-path`; it is not read from the environment.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3.5:4b

# Promotion updater (`openai_lmstudio_promotion_update.py`)
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen3.5:9b
PROMOTION_BACKUP_DIR=promotion_backups
