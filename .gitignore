# --- Environment variables ---
backend/.venv/
backend/private_cache/
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local
!**/.env.example

# --- Sensitive data & credentials (never commit) ---
# Navicat / mysqldump exports with real users, resumes, password hashes
datasets/**/*.sql
datasets/**/*.dump
datasets/**/*.sql.gz
*.sql.dump
backups/
**/backup/**/*.sql

# SSH / TLS private keys
*.pem
*.ppk
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# Local-only exports (keep backend/schema.sql + migrations tracked)
**/suilli_mizi.sql

# 简历 OCR 临时文件（OCR 后自动删除，勿提交）
backend/private_uploads/

# --- Python 缓存 & 运行文件（必须加！）---
__pycache__/
*/__pycache__/
**/__pycache__/
***/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.pytest_cache/
.tmp/
backend/.pytest-*/
frontend/test-results/
frontend/playwright-report/
.idea/
backend/app/static

# --- Runtime uploads and OCR derivatives ---
backend/app/static/uploads/
backend/app/static/uploads/pdf_images/
**/pdf_images/

# --- Large/raw data artifacts (curated CSVs stay tracked) ---
datasets/snapshots/*
!datasets/snapshots/.gitkeep
datasets/*.[xX][lL][sS]
datasets/*.[xX][lL][sS][xX]
tools/job_eval/job_eval_results_*.jsonl
tools/job_eval/IMG_*
tools/job_eval/*_qc_report.*
generate_graph/promotion_backups/
generate_graph/*.xls
generate_graph/*.xlsx

